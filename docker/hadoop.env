# The Apache Hadoop image turns "<FILE>.XML_<property>" variables into config.
CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020
CORE-SITE.XML_hadoop.http.staticuser.user=hadoop

HDFS-SITE.XML_dfs.replication=1
HDFS-SITE.XML_dfs.namenode.name.dir=/hadoop/dfs/name
HDFS-SITE.XML_dfs.datanode.data.dir=/hadoop/dfs/data
HDFS-SITE.XML_dfs.webhdfs.enabled=true

# Single node, one trusted user, no Kerberos. Permission checks here would only
# be theatre, and they break WebHDFS writes from a client with a different name.
HDFS-SITE.XML_dfs.permissions.enabled=false

# The NameNode refuses writes while it believes it has no live DataNode. On a
# single node with one replica, a slow DataNode registration otherwise turns
# into a confusing "could only be written to 0 of 1 nodes" error.
HDFS-SITE.XML_dfs.namenode.replication.min=1
