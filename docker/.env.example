# Copy to docker/.env and fill in.
#
# The tailnet address of the machine running the broker. Compose refuses to
# start if this is empty, which is deliberate: an empty value would bind
# 0.0.0.0 and expose an unauthenticated broker to the LAN.
SENTINEL_TAILNET_IP=100.x.x.x

# The public dashboard. Redaction is on unless SENTINEL_PUBLIC is 0, so an
# unset file is the safe one. Aliases are optional and only improve how the
# page reads: without them a host appears as host-<digest>. The salt makes the
# digest unguessable, so set it once and never change it, because changing it
# renames every host on the page.
#
# SENTINEL_PUBLIC=1
# SENTINEL_HOST_ALIASES=real-hostname=workstation-01,other-hostname=edge-01
# SENTINEL_ALIAS_SALT=any-long-random-string
#
# Seconds to hold readings back before showing them. Zero is live, which also
# means the page reveals in real time whether each machine is switched on. A
# value like 86400 turns the page into yesterday's view and removes that.
# SENTINEL_PUBLIC_LAG_SECONDS=0

# Optional pins.
KAFKA_VERSION=3.9.0
KAFKA_CLUSTER_ID=sentinel-single-node-0001
