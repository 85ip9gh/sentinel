# Copy to docker/.env and fill in.
#
# The tailnet address of the machine running the broker. Compose refuses to
# start if this is empty, which is deliberate: an empty value would bind
# 0.0.0.0 and expose an unauthenticated broker to the LAN.
SENTINEL_TAILNET_IP=100.x.x.x

# Optional pins.
KAFKA_VERSION=3.9.0
KAFKA_CLUSTER_ID=sentinel-single-node-0001
